# ─────────────────────────────────────────────────────────────────────────────
# AVHIFocus environment.
# With NO variables set, the app runs in built-in DEMO mode (local browser
# backend with cross-tab realtime). Add Supabase credentials to enable the
# real multi-device backend. NEVER put service-role keys here — anything
# prefixed VITE_ ships to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Web Push public VAPID key (pair lives only in the Edge Function).
VITE_VAPID_PUBLIC_KEY=
